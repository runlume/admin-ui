{
  "name": "@runlume/admin-ui",
  "version": "0.3.0",
  "type": "module",
  "description": "Runlume 标准后台组件库：UI 原语、数据组件、控制台外壳、主题与语义 Token",
  "license": "Apache-2.0",
  "files": [
    "dist-package",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist-package/admin-ui.d.ts",
      "import": "./dist-package/admin-ui.js",
      "require": "./dist-package/admin-ui.cjs"
    },
    "./components/*": {
      "types": "./dist-package/components/*.d.ts",
      "import": "./dist-package/components/*.js",
      "require": "./dist-package/components/*.cjs"
    },
    "./ui/*": {
      "types": "./dist-package/components/ui/*.d.ts",
      "import": "./dist-package/components/ui/*.js",
      "require": "./dist-package/components/ui/*.cjs"
    },
    "./hooks/*": {
      "types": "./dist-package/hooks/*.d.ts",
      "import": "./dist-package/hooks/*.js",
      "require": "./dist-package/hooks/*.cjs"
    },
    "./lib/*": {
      "types": "./dist-package/lib/*.d.ts",
      "import": "./dist-package/lib/*.js",
      "require": "./dist-package/lib/*.cjs"
    },
    "./theme.css": "./dist-package/theme.css",
    "./styles.css": "./dist-package/styles.css"
  },
  "types": "./dist-package/admin-ui.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/runlume/admin-ui.git"
  },
  "homepage": "https://github.com/runlume/admin-ui#readme",
  "bugs": {
    "url": "https://github.com/runlume/admin-ui/issues"
  },
  "scripts": {
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/fix-dts-imports.mjs && node scripts/copy-theme-css.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "prepack": "pnpm build:lib",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "lint": "oxlint",
    "test": "vitest run --maxWorkers=2",
    "test:watch": "vitest",
    "format": "prettier --write src README.md README.en.md AGENTS.md",
    "format:check": "prettier --check src README.md README.en.md AGENTS.md",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build:lib"
  },
  "dependencies": {
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.44.0",
    "pinyin-pro": "3.28.1",
    "radix-ui": "1.6.7",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "zustand": "5.0.15"
  },
  "peerDependencies": {
    "i18next": ">=23",
    "react": ">=18.2.0 <20",
    "react-dom": ">=18.2.0 <20",
    "react-i18next": ">=13",
    "react-router": ">=6.4 <8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "i18next": "26.4.2",
    "jsdom": "30.0.1",
    "oxlint": "^1.81.0",
    "prettier": "3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "17.0.13",
    "react-router": "7.18.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  }
}
